# ==========================================================
#  SIGEP-18BPM v2 — variaveis de ambiente
#  Copie este arquivo para ".env" e preencha os valores.
#  No Vercel, cadastre as mesmas chaves em Settings > Environment Variables.
# ==========================================================

# --- Banco de dados (Neon) — Fase 1 / Fase 2 ---
# Pegue em: Neon > seu projeto > Connection string (Pooled connection)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.neon.tech/sigep_producao?sslmode=require"

# --- NextAuth — Fase 3 ---
# Em producao, NEXTAUTH_URL deve ser a URL do Vercel (ex: https://sigep-v2.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
# Gere um segredo forte com:  openssl rand -base64 32
NEXTAUTH_SECRET="cole-aqui-um-segredo-aleatorio"

# --- Cloudflare R2 — Fase 1 / Fase 3 ---
# Pegue em: Cloudflare > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="sigep-documentos"
# Opcional: dominio publico do bucket, se voce ativar acesso publico
R2_PUBLIC_URL=""
