// ==========================================================
//  SIGEP-18BPM v2 — schema.prisma (FIEL aos dados reais)
//  Fase 2 da migracao.
//
//  Campos tipados como texto de proposito: garante que a
//  importacao do CSV nao quebre por causa de data vazia ou
//  formato inesperado. Os tipos sao apertados depois (Fase 3+),
//  com os dados ja dentro.
//
//  Rodar:  npm run db:push   (cria as tabelas no Neon)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------
//  Usuarios — login do sistema
// ----------------------------------------------------------
model Usuario {
  id           String  @id @map("ID")
  login        String  @unique @map("Login")
  nomeCompleto String? @map("NomeCompleto")
  email        String? @map("Email")
  senhaHash    String? @map("SenhaHash")
  salt         String? @map("Salt")
  ativo        String? @map("Ativo")
  dataCriacao  String? @map("DataCriacao")
  ultimoLogin  String? @map("UltimoLogin")
  perfil       String? @map("Perfil")
  refEfetivo   String? @map("RefEfetivo")

  precisaTrocar Boolean? @default(true) @map("PrecisaTrocar") // NOVO
  tentativas    Int?     @default(0) @map("Tentativas") // NOVO
  bloqueadoAte  String?  @map("BloqueadoAte") // NOVO

  efetivo Efetivo? @relation(fields: [refEfetivo], references: [id])

  @@map("usuarios")
}

// ----------------------------------------------------------
//  Efetivo — ficha individual (51 colunas)
//  Chave: ID (o ID PMMA, ex: 849988). Matricula e campo a parte.
// ----------------------------------------------------------
model Efetivo {
  id                 String  @id @map("ID")
  postoGrad          String? @map("Posto_Grad")
  numeroBarra        String? @map("Numero_Barra")
  nome               String? @map("Nome")
  nomeGuerra         String? @map("NomeGuerra")
  cpf                String? @map("CPF")
  matricula          String? @map("Matricula")
  rg                 String? @map("RG")
  situacao           String? @map("Situacao")
  lotacao            String? @map("Lotacao")
  telefone           String? @map("Telefone")
  dataNasc           String? @map("DataNasc")
  dataIncorp         String? @map("DataIncorp")
  dataPromocao       String? @map("DataPromocao")
  estadoCivil        String? @map("EstadoCivil")
  email              String? @map("Email")
  equipeFerias       String? @map("EquipeFerias")
  funcao             String? @map("Funcao")
  status             String? @map("Status")
  sexo               String? @map("Sexo")
  endereco           String? @map("Endereco")
  bairro             String? @map("Bairro")
  cidade             String? @map("Cidade")
  cep                String? @map("CEP")
  naturalidade       String? @map("Naturalidade")
  naturalidadeUF     String? @map("NaturalidadeUF")
  nomePai            String? @map("NomePai")
  nomeMae            String? @map("NomeMae")
  tipoSanguineo      String? @map("TipoSanguineo")
  fatorRH            String? @map("FatorRH")
  quadro             String? @map("Quadro")
  grauEscolaridade   String? @map("GrauEscolaridade")
  cursosPMMA         String? @map("CursosPMMA")
  banco              String? @map("Banco")
  agencia            String? @map("Agencia")
  conta              String? @map("Conta")
  tipoConta          String? @map("TipoConta")
  possuiDependentes  String? @map("PossuiDependentes")
  emergenciaNome     String? @map("EmergenciaNome")
  emergenciaTelefone String? @map("EmergenciaTelefone")
  emergenciaGrau     String? @map("EmergenciaGrau")
  cnh                String? @map("CNH")
  cnhCategoria       String? @map("CNH_Categoria")
  cnhVencimento      String? @map("CNH_Vencimento")
  fotoURL            String? @map("FotoURL")
  observacoes        String? @map("Observacoes")
  dataCadastro       String? @map("DataCadastro")
  ultimaAtualizacao  String? @map("UltimaAtualizacao")
  jmsDataInicio      String? @map("JMS_DataInicio")
  jmsDataRetorno     String? @map("JMS_DataRetorno")
  jmsMotivo          String? @map("JMS_Motivo")

  usuarios      Usuario[]
  membrosFerias MembroFerias[]
  documentos    Documento[]

  @@map("efetivo")
}

// ----------------------------------------------------------
//  EquipesFerias — 9 equipes, dois periodos cada
//  Chave composta: numero da equipe + ano de gozo
// ----------------------------------------------------------
model EquipeFerias {
  numeroEquipe   String  @map("NumeroEquipe")
  anoGozo        String  @map("AnoGozo")
  periodo1Inicio String? @map("Periodo1_Inicio")
  periodo1Fim    String? @map("Periodo1_Fim")
  periodo1Apres  String? @map("Periodo1_Apres")
  periodo2Inicio String? @map("Periodo2_Inicio")
  periodo2Fim    String? @map("Periodo2_Fim")
  periodo2Apres  String? @map("Periodo2_Apres")
  observacoes    String? @map("Observacoes")

  membros MembroFerias[]

  @@id([numeroEquipe, anoGozo])
  @@map("equipes_ferias")
}

// ----------------------------------------------------------
//  MembrosFerias — liga militar -> equipe (por ano)
// ----------------------------------------------------------
model MembroFerias {
  id           String  @id @default(cuid())
  idPmma       String  @map("ID_PMMA")
  numeroEquipe String  @map("NumeroEquipe")
  anoGozo      String  @map("AnoGozo")
  dataCadastro String? @map("DataCadastro")

  efetivo Efetivo      @relation(fields: [idPmma], references: [id])
  equipe  EquipeFerias @relation(fields: [numeroEquipe, anoGozo], references: [numeroEquipe, anoGozo])

  @@map("membros_ferias")
}

// ----------------------------------------------------------
//  Config — pares chave/valor do sistema
// ----------------------------------------------------------
model Config {
  chave     String  @id @map("Chave")
  valor     String? @map("Valor")
  descricao String? @map("Descricao")

  @@map("config")
}

// ----------------------------------------------------------
//  Documentos — guarda SO o link do R2 (sem dado a migrar
//  agora; tabela usada pelo upload na Fase 3)
// ----------------------------------------------------------
model Documento {
  id           String   @id @default(cuid())
  titulo       String
  tipo         String?
  r2Key        String   @map("r2_key")
  r2Url        String?  @map("r2_url")
  tamanhoBytes Int?     @map("tamanho_bytes")
  criadoEm     DateTime @default(now()) @map("criado_em")

  efetivoId String?  @map("efetivo_id")
  efetivo   Efetivo? @relation(fields: [efetivoId], references: [id])

  @@map("documentos")
}

// ==========================================================
//  >>> ANEXAR ESTE BLOCO AO FINAL DO seu prisma/schema.prisma <<<
//
//  Sao 3 tabelas novas do modulo Promocoes/Certidoes.
//  Nao apague nada do que ja existe; so cole isto no fim do
//  arquivo, depois rode:  npx prisma db push
// ==========================================================

// Periodo de promocao (ex.: "Promocao 01/08/2026").
model PeriodoPromocao {
  id       String   @id @default(cuid())
  nome     String
  dataAlvo String?  @map("data_alvo") // ex.: "2026-08-01"
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  participantes ParticipantePromocao[]

  @@map("periodos_promocao")
}

// Militar que entrou em um periodo (todo efetivo pode; na pratica
// poucos enviam). O progresso e calculado pelas certidoes enviadas.
model ParticipantePromocao {
  id           String    @id @default(cuid())
  periodoId    String    @map("periodo_id")
  efetivoId    String    @map("efetivo_id") // ID PMMA do militar
  pdfUnificado String?   @map("pdf_unificado") // chave do PDF unico no R2
  geradoEm     DateTime? @map("gerado_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")

  periodo   PeriodoPromocao   @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  certidoes CertidaoEnviada[]

  @@unique([periodoId, efetivoId])
  @@map("participantes_promocao")
}

// Cada certidao enviada por um participante (uma das 8 fixas).
model CertidaoEnviada {
  id             String   @id @default(cuid())
  participanteId String   @map("participante_id")
  ordem          Int // 1..8 (ordem oficial)
  r2Key          String   @map("r2_key") // caminho do PDF no R2
  nomeArquivo    String?  @map("nome_arquivo")
  tamanhoBytes   Int?     @map("tamanho_bytes")
  enviadaEm      DateTime @default(now()) @map("enviada_em")

  participante ParticipantePromocao @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@unique([participanteId, ordem]) // 1 arquivo por posicao
  @@map("certidoes_enviadas")
}

// ==========================================================
//  >>> ANEXAR AO FINAL DO prisma/schema.prisma <<<
//  Guarda quais alertas ja foram dispensados (para nao
//  voltarem a aparecer). Depois rode: npx prisma db push
// ==========================================================

model AlertaDispensado {
  id            String   @id @default(cuid())
  chave         String   @unique // identificador unico do alerta, ex: "jms:849988" ou "ferias2v:849988"
  tipo          String // "jms_vencendo" | "ferias_vencidas"
  dispensadoPor String?  @map("dispensado_por")
  dispensadoEm  DateTime @default(now()) @map("dispensado_em")

  @@map("alertas_dispensados")
}

// ==========================================================
//  >>> ANEXAR AO FINAL DO prisma/schema.prisma <<<
//  Avisos manuais (lembretes) criados pelo admin, exibidos
//  no banner do dashboard ate a validade ou remocao.
//  Depois rode: npx prisma db push
// ==========================================================

model Aviso {
  id        String   @id @default(cuid())
  texto     String
  cor       String   @default("info") // "critico" | "atencao" | "info"
  validade  String?  @map("validade") // "aaaa-mm-dd"; vazio = sem expirar
  criadoPor String?  @map("criado_por")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("avisos")
}

// ==========================================================
//  >>> ANEXAR AO FINAL DO prisma/schema.prisma <<<
//  JOE — Jornada Operacional Extraordinaria (servico extra
//  remunerado). O P1 (admin) abre um JOE com vagas e valor;
//  policiais com login se candidatam; o P1 aprova um a um.
//  Depois rode: npx prisma db push
// ==========================================================

model Joe {
  id         String   @id @default(cuid())
  evento     String // OPERAÇÃO (nome) — usado como "OPERAÇÃO:" na RENE
  local      String?
  data       String // "aaaa-mm-dd" — vira "DATA:" na RENE
  horaInicio String   @map("hora_inicio")
  horaFim    String   @map("hora_fim")
  vagas      Int      @default(1)
  valor      Float    @default(0)
  observacao String?
  status     String   @default("aberta") // "aberta" | "encerrada"
  criadoPor  String?  @map("criado_por")
  criadoEm   DateTime @default(now()) @map("criado_em")

  // ---- campos da RENE (novos) ----
  comandanteOp String? @map("comandante_op") // COMANDANTE DA OPERAÇÃO
  horario      String? @map("horario_rene") // HORÁRIO ex.: "20h às 02h"
  areaAtuacao  String? @map("area_atuacao") // ÁREA DE ATUAÇÃO
  processoSei  String? @map("processo_sei") // Nº PROCESSO SEI – AUTORIZAÇÃO
  reneKey      String? @map("rene_key") // chave do DOCX da RENE no R2

  inscricoes JoeInscricao[]

  @@map("joe")
}

model JoeInscricao {
  id        String  @id @default(cuid())
  joeId     String  @map("joe_id")
  efetivoId String? @map("efetivo_id") // opcional: null = militar de fora do 18

  // dados manuais (usados quando efetivoId e null, militar de outra OPM)
  extNome      String? @map("ext_nome")
  extMatricula String? @map("ext_matricula")
  extPostoGrad String? @map("ext_posto_grad")
  extUnidade   String? @map("ext_unidade")

  origem      String    @default("auto") // "auto" = policial se inscreveu | "p1" = P/1 inscreveu
  status      String    @default("pendente")
  inscritoEm  DateTime  @default(now()) @map("inscrito_em")
  decididoEm  DateTime? @map("decidido_em")
  decididoPor String?   @map("decidido_por")

  joe Joe @relation(fields: [joeId], references: [id], onDelete: Cascade)

  @@map("joe_inscricoes")
}

// ==========================================================
//  >>> ANEXAR AO FINAL do prisma/schema.prisma <<<
//  Cursos: o admin abre um curso; policiais demonstram
//  interesse (inscricao). Sem aprovacao, sem valor.
//  Depois: npx prisma db push
// ==========================================================

model Curso {
  id        String   @id @default(cuid())
  nome      String // ex: "Curso de Formacao de Sargentos"
  local     String? // onde sera
  vagas     Int      @default(0) // 0 = nao informado
  prazo     String?  @map("prazo") // "aaaa-mm-dd" limite de inscricao
  descricao String? // detalhes livres
  status    String   @default("aberto") // "aberto" | "encerrado"
  criadoPor String?  @map("criado_por") // login do admin que abriu
  criadoEm  DateTime @default(now()) @map("criado_em")

  inscricoes CursoInscricao[]

  @@map("cursos")
}

model CursoInscricao {
  id         String   @id @default(cuid())
  cursoId    String   @map("curso_id")
  efetivoId  String   @map("efetivo_id") // ID PMMA do interessado
  inscritoEm DateTime @default(now()) @map("inscrito_em")

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, efetivoId]) // 1 interesse por militar por curso
  @@map("curso_inscricoes")
}

// ============================================================
// ADICIONAR ESTE MODEL AO SEU prisma/schema.prisma
// Depois rodar: npx prisma migrate dev --name add_cfs2026
// ============================================================

model RequerimentoCFS2026 {
  id String @id @default(cuid())

  // Dados do PM
  matricula      String   @unique
  idPmma         String? // ID PMMA opcional para vincular ao cadastro
  nomeCompleto   String
  nomeGuerra     String?
  graduacao      String // SD PM, CB PM, 3 SGT PM, 2 SGT PM, 1 SGT PM
  dataNascimento DateTime
  cpf            String?
  rg             String?

  // Contato
  email    String
  telefone String

  // Lotacao
  lotacao     String // Ex: 1 CIA, 2 CIA, ROTEM, P1, P2, P3, P4
  funcaoAtual String?

  // Inscricao
  dataInscricao DateTime  @default(now())
  status        String    @default("PENDENTE") // PENDENTE, VALIDADO, REJEITADO
  observacoes   String?
  validadoPor   String?
  validadoEm    DateTime?

  // Auditoria
  ipOrigem    String?
  userAgent   String?
  fonteOrigem String  @default("GOOGLE_FORMS") // GOOGLE_FORMS, MANUAL, IMPORT

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([graduacao])
  @@index([lotacao])
  @@map("requerimentos_cfs_2026")
}

model Auditoria {
  id           String   @id @default(cuid())
  quando       DateTime @default(now()) @map("Quando")
  autorLogin   String?  @map("AutorLogin")
  autorNome    String?  @map("AutorNome")
  acao         String   @map("Acao")
  alvo         String?  @map("Alvo")
  alvoNome     String?  @map("AlvoNome")
  detalhe      String?  @map("Detalhe")
  antes        String?  @map("Antes")
  depois       String?  @map("Depois")
  ip           String?  @map("Ip")
  dispositivo  String?  @map("Dispositivo") // celular/computador + SO + navegador
  hash         String?  @map("Hash") // lacre: sha256(hashAnterior + conteudo)
  hashAnterior String?  @map("HashAnterior") // encadeia com o registro anterior

  @@index([quando])
  @@index([autorLogin])
  @@map("auditoria")
}

// ==========================================================
//  >>> ANEXAR AO FINAL DO prisma/schema.prisma <<<
//  Modulo de Requerimentos. O policial preenche e envia; o
//  admin (P/1) analisa, preenche a pagina 2 e defere/indefere.
//  Depois rode: npx prisma db push
// ==========================================================

model Requerimento {
  id String @id @default(cuid())

  // quem fez
  efetivoId String @map("efetivo_id") // ID PMMA do requerente

  // tipo
  modelo           String // "comum" | "cursos"
  modalidade       String // ex: "SALÁRIO FAMÍLIA", "CFS", "OUTROS"
  modalidadeOutros String? @map("modalidade_outros") // texto quando modalidade = OUTROS

  // dados pessoais (snapshot no momento do envio; tudo editavel pelo policial)
  nomeCompleto    String? @map("nome_completo")
  endereco        String?
  complemento     String?
  bairro          String?
  municipio       String?
  fone            String?
  dataNasc        String? @map("data_nasc")
  dataInclusao    String? @map("data_inclusao")
  matricula       String?
  idPmmaTxt       String? @map("id_pmma_txt") // o "ID" que aparece no modelo cursos
  postoGrad       String? @map("posto_grad")
  numeroPm        String? @map("numero_pm")
  tempoServico    String? @map("tempo_servico")
  cargoFuncao     String? @map("cargo_funcao")
  estadoCivil     String? @map("estado_civil")
  opmClassificado String? @map("opm_classificado")
  opmExercicio    String? @map("opm_exercicio")

  // so cursos
  cpf   String?
  email String?

  // corpo
  amparoLegal   String? @map("amparo_legal")
  infoAdicional String? @map("info_adicional")

  // pagina 2 (policial sugere, admin confirma)
  p2Conceito       String? @map("p2_conceito") // Comportamento/Conceito militar
  p2SituacaoJur    String? @map("p2_situacao_jur") // Situacao juridica
  p2Complementares String? @map("p2_complementares") // os 6 itens (texto)
  p2UltimaPromocao String? @map("p2_ultima_promocao")
  p2DataInclusao   String? @map("p2_data_inclusao")

  // fluxo
  status       String    @default("rascunho") // rascunho | enviado | deferido | indeferido
  parecer      String? // parecer do admin
  analisadoPor String?   @map("analisado_por")
  analisadoEm  DateTime? @map("analisado_em")

  // arquivos gerados (chaves no R2)
  docxKey  String? @map("docx_key")
  pdfKey   String? @map("pdf_key")
  assinado Boolean @default(false) // se ja foi assinado no sistema

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([efetivoId])
  @@index([status])
  @@map("requerimentos")
}

// Perfil de dados do requerente, salvo para reuso (preenche uma vez,
// reaproveita nos proximos requerimentos). 1 por efetivo.
model PerfilRequerente {
  efetivoId       String   @id @map("efetivo_id")
  endereco        String?
  complemento     String?
  bairro          String?
  municipio       String?
  fone            String?
  cargoFuncao     String?  @map("cargo_funcao")
  estadoCivil     String?  @map("estado_civil")
  opmClassificado String?  @map("opm_classificado")
  opmExercicio    String?  @map("opm_exercicio")
  cpf             String?
  email           String?
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  @@map("perfis_requerente")
}

// ==========================================================
//  >>> ANEXAR AO FINAL DO prisma/schema.prisma <
//  Inscricoes de Web Push: cada navegador/dispositivo que
//  aceitou notificacoes gera uma inscricao (endpoint + chaves).
//  Um usuario pode ter varias (celular, desktop, etc.).
//  Depois rode: npx prisma db push
// ==========================================================

model PushSubscription {
  id        String   @id @default(cuid())
  login     String   @map("login") // login do usuario dono da inscricao
  endpoint  String   @unique @map("endpoint") // URL unica do navegador
  p256dh    String   @map("p256dh") // chave publica do cliente
  auth      String   @map("auth") // segredo do cliente
  userAgent String?  @map("user_agent")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([login])
  @@map("push_subscriptions")
}

// ==========================================================
//  >>> ANEXAR AO FINAL DO prisma/schema.prisma <
//  Licenca-Premio: mesma logica das Equipes de Ferias, porem
//  com 1 unico periodo (90 dias) e 4 equipes por ano.
//  Depois rode: npx prisma db push
// ==========================================================

model EquipeLicencaPremio {
  numeroEquipe  String  @map("NumeroEquipe")
  anoGozo       String  @map("AnoGozo")
  periodoInicio String? @map("Periodo_Inicio")
  periodoFim    String? @map("Periodo_Fim")

  membros MembroLicencaPremio[]

  @@id([numeroEquipe, anoGozo])
  @@map("equipes_licenca_premio")
}

model MembroLicencaPremio {
  id           String   @id @default(cuid())
  idPmma       String   @map("ID_PMMA")
  numeroEquipe String   @map("NumeroEquipe")
  anoGozo      String   @map("AnoGozo")
  criadoEm     DateTime @default(now()) @map("criado_em")

  equipe EquipeLicencaPremio @relation(fields: [numeroEquipe, anoGozo], references: [numeroEquipe, anoGozo])

  @@unique([idPmma, anoGozo])
  @@map("membros_licenca_premio")
}

// ----------------------------------------------------------
//  CHAT interno — conversa direta entre quaisquer dois usuários
//  (admins e policiais). Anexos ficam no R2; aqui guardamos só
//  a chave do objeto. Sem trilha de auditoria, por decisão do P/1.
// ----------------------------------------------------------
model ChatMensagem {
  id       String    @id @default(cuid())
  de       String    @map("De") // login de quem enviou
  para     String    @map("Para") // login de quem recebe
  texto    String?   @map("Texto")
  arqKey   String?   @map("ArqKey") // chave do anexo no R2
  arqNome  String?   @map("ArqNome")
  arqTipo  String?   @map("ArqTipo")
  arqTam   Int?      @map("ArqTam")
  criadoEm DateTime  @default(now()) @map("CriadoEm")
  lidaEm   DateTime? @map("LidaEm")

  // Colunas criadas em runtime por lib/chatDb.ts (o deploy nao roda db push).
  respondeA   String?   @map("RespondeA") // id da mensagem citada
  editadaEm   DateTime? @map("EditadaEm")
  apagadaEm   DateTime? @map("ApagadaEm") // apagada para todos
  encaminhada Boolean   @default(false) @map("Encaminhada")
  reacoes     String?   @map("Reacoes") // JSON { login: emoji } — no 1-a-1 sao no maximo 2

  @@index([de, para, criadoEm])
  @@index([para, lidaEm])
  @@map("chat_mensagens")
}

// Como CADA UM organiza a conversa com outra pessoa: fixar no topo, arquivar,
// marcar como nao lida e silenciar. E por usuario — eu fixar a conversa nao
// fixa nada do outro lado. Tabela criada em runtime por lib/chatDb.ts.
model ChatConversa {
  login         String    @map("Login")
  com           String    @map("Com")
  fixada        Boolean   @default(false) @map("Fixada")
  arquivada     Boolean   @default(false) @map("Arquivada")
  naoLida       Boolean   @default(false) @map("NaoLida") // marcada à mão
  silenciadaAte DateTime? @map("SilenciadaAte") // nulo = com som

  @@id([login, com])
  @@map("chat_conversa")
}

// Batida de presença: quem apareceu há menos de ~1 min está online.
model ChatPresenca {
  login String   @id @map("Login")
  visto DateTime @map("Visto")

  // Login da conversa aberta agora (nulo = nenhuma). Criada em runtime.
  olhando String? @map("Olhando")

  @@map("chat_presenca")
}

// ----------------------------------------------------------
//  Chamada de voz/vídeo do chat (WebRTC).
//  O áudio e o vídeo vão DIRETO entre os dois aparelhos; o banco guarda
//  só a "negociação" (quem chama quem, as ofertas SDP e os candidatos de
//  rede). Por isso a conversa em si não passa pelo servidor.
// ----------------------------------------------------------
model ChatChamada {
  id       String   @id @default(cuid())
  de       String   @map("De") // login de quem ligou
  para     String   @map("Para") // login de quem recebe
  video    Boolean  @default(false) @map("Video")
  estado   String   @default("chamando") @map("Estado") // chamando|aceita|recusada|encerrada|perdida
  oferta   String?  @map("Oferta") // SDP de quem ligou
  resposta String?  @map("Resposta") // SDP de quem atendeu
  iceDe    String?  @map("IceDe") // candidatos de rede (JSON) do chamador
  icePara  String?  @map("IcePara") // candidatos de rede (JSON) de quem atendeu
  criadoEm DateTime @default(now()) @map("CriadoEm")
  mudouEm  DateTime @updatedAt @map("MudouEm")

  @@index([para, estado])
  @@index([de, estado])
  @@map("chat_chamadas")
}
